#!/data/data/com.termux/files/usr/bin/env python3
import sys
import os
import argparse
import json
from pathlib import Path

# Add project root to sys.path
sys.path.append(os.path.abspath(os.path.join(os.path.dirname(__file__), '..')))
from lib.json import JSONFlattener

def main():
    parser = argparse.ArgumentParser(description="JSON Hierarchical Flattener & Unflattener")
    subparsers = parser.add_subparsers(dest="command", help="Flatten or unflatten action")

    # flatten
    p_flat = subparsers.add_parser("flatten", help="Flatten deep nested JSON into dot-separated keys")
    p_flat.add_argument("target", nargs="?", help="JSON file or raw JSON string")
    p_flat.add_argument("-d", "--delimiter", default=".", help="Key separator delimiter (default: '.')")

    # unflatten
    p_unflat = subparsers.add_parser("unflatten", help="Restore deep nested JSON from flat dot-separated keys")
    p_unflat.add_argument("target", nargs="?", help="Flat JSON file or raw JSON string")
    p_unflat.add_argument("-d", "--delimiter", default=".", help="Key separator delimiter (default: '.')")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(0)

    raw_json = args.target
    if not raw_json and not sys.stdin.isatty():
        raw_json = sys.stdin.read()
    elif raw_json:
        p = Path(raw_json)
        if p.exists() and p.is_file():
            raw_json = p.read_text(encoding="utf-8", errors="ignore")

    if not raw_json:
        parser.print_help()
        sys.exit(0)

    try:
        data = json.loads(raw_json)
    except Exception as e:
        print(f"❌ Invalid JSON: {e}", file=sys.stderr)
        sys.exit(1)

    if args.command == "flatten":
        res = JSONFlattener.flatten(data, delimiter=args.delimiter)
        print(json.dumps(res, indent=2, ensure_ascii=False))
    elif args.command == "unflatten":
        res = JSONFlattener.unflatten(data, delimiter=args.delimiter)
        print(json.dumps(res, indent=2, ensure_ascii=False))

if __name__ == "__main__":
    main()
