#!/usr/bin/env python3
import sys
import os
import argparse
import json
from pathlib import Path

# Add project root to sys.path
sys.path.append(os.path.abspath(os.path.join(os.path.dirname(__file__), '..')))
from lib.json import JSONSanitizer

def main():
    parser = argparse.ArgumentParser(description="Automated JSON Secret, PII & Token Redactor")
    parser.add_argument("target", nargs="?", help="JSON file or raw JSON string")
    parser.add_argument("-m", "--mask", default="***REDACTED***", help="Replacement mask text")
    parser.add_argument("-i", "--in-place", action="store_true", help="Modify file in-place")
    args = parser.parse_args()

    raw_json = args.target
    target_path = None
    if not raw_json and not sys.stdin.isatty():
        raw_json = sys.stdin.read()
    elif raw_json:
        p = Path(raw_json)
        if p.exists() and p.is_file():
            target_path = p
            raw_json = p.read_text(encoding="utf-8", errors="ignore")

    if not raw_json:
        parser.print_help()
        sys.exit(0)

    sanitized = JSONSanitizer.sanitize(raw_json, mask=args.mask)
    output_str = json.dumps(sanitized, indent=2, ensure_ascii=False)

    if args.in_place and target_path:
        target_path.write_text(output_str, encoding="utf-8")
        print(f"🔒 Sanitized secrets in {target_path}")
    else:
        print(output_str)

if __name__ == "__main__":
    main()
