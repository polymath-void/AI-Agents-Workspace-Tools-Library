#!/data/data/com.termux/files/usr/bin/env python3
import sys
import os
import argparse
import json
from pathlib import Path

# Add project root to sys.path
sys.path.append(os.path.abspath(os.path.join(os.path.dirname(__file__), '..')))
from lib.workflow.context_manager import WorkflowContextManager

def main():
    parser = argparse.ArgumentParser(description="Multi-Workflow Context Isolation & Hand-off Manager")
    subparsers = parser.add_subparsers(dest="command", help="Workflow context command")

    # register
    p_reg = subparsers.add_parser("register", help="Register a workflow namespace")
    p_reg.add_argument("workflow_id", help="Unique workflow ID")
    p_reg.add_argument("name", nargs="?", default="Unnamed Workflow", help="Workflow descriptive name")

    # set
    p_set = subparsers.add_parser("set", help="Save a discrete context frame for a workflow")
    p_set.add_argument("workflow_id", help="Workflow ID")
    p_set.add_argument("key", help="Context frame key")
    p_set.add_argument("value", help="JSON string or raw text payload")

    # get
    p_get = subparsers.add_parser("get", help="Get active context for a workflow")
    p_get.add_argument("workflow_id", help="Workflow ID")
    p_get.add_argument("--json", action="store_true", help="Output raw JSON")

    # handoff
    p_hnd = subparsers.add_parser("handoff", help="Transfer context keys from one workflow to another")
    p_hnd.add_argument("source_wf", help="Source workflow ID")
    p_hnd.add_argument("target_wf", help="Target workflow ID")
    p_hnd.add_argument("keys", nargs="*", help="Optional specific keys to hand off")

    # prune
    p_prn = subparsers.add_parser("prune", help="Prune historical frames to enforce token limit")
    p_prn.add_argument("workflow_id", help="Workflow ID")
    p_prn.add_argument("-m", "--max-frames", type=int, default=10, help="Maximum frames to keep")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(0)

    mgr = WorkflowContextManager()

    if args.command == "register":
        res = mgr.register_workflow(args.workflow_id, args.name)
        print(f"✅ Registered workflow namespace: {args.workflow_id} ('{args.name}')")

    elif args.command == "set":
        try:
            val = json.loads(args.value)
        except Exception:
            val = args.value
        res = mgr.set_frame(args.workflow_id, args.key, val)
        print(f"✅ Saved context frame '{args.key}' for workflow '{args.workflow_id}' (~{res['token_estimate']} tokens)")

    elif args.command == "get":
        ctx = mgr.get_context(args.workflow_id)
        if args.json:
            print(json.dumps(ctx, indent=2, ensure_ascii=False))
        else:
            print(f"📦 Context for Workflow: {ctx['workflow_id']} (Total Tokens: ~{ctx['total_tokens']})")
            for k, f in ctx.get("frames", {}).items():
                print(f"  • {k}: {json.dumps(f['value'])} [~{f['tokens']} tok]")

    elif args.command == "handoff":
        keys = args.keys if args.keys else None
        res = mgr.handoff_context(args.source_wf, args.target_wf, keys)
        print(f"🔄 Handed off {len(res['transferred_keys'])} context keys from '{args.source_wf}' -> '{args.target_wf}'")

    elif args.command == "prune":
        res = mgr.prune_workflow_context(args.workflow_id, args.max_frames)
        print(f"🧹 Pruned workflow '{args.workflow_id}' context to {args.max_frames} frames")

if __name__ == "__main__":
    main()
