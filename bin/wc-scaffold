#!/data/data/com.termux/files/usr/bin/env python3
import sys
import os
import argparse

# Add the lib directory to sys.path
sys.path.append(os.path.join(os.path.dirname(__file__), '../lib'))
from scaffolder import scaffold_compose_component, scaffold_repository, scaffold_extension_template

def main():
    parser = argparse.ArgumentParser(description="Zero-Overhead Code & Component Scaffolder")
    subparsers = parser.add_subparsers(dest="command", help="Scaffolding type")

    # Compose component
    compose_p = subparsers.add_parser("compose", help="Scaffold a Jetpack Compose component")
    compose_p.add_argument("file", help="Destination file path (e.g. MyWidgetModal.kt)")
    compose_p.add_argument("-p", "--package", default="com.piuu.launcher.ui.components", help="Kotlin package name")

    # Repository
    repo_p = subparsers.add_parser("repo", help="Scaffold a Kotlin StateFlow repository")
    repo_p.add_argument("file", help="Destination file path (e.g. SettingsRepository.kt)")
    repo_p.add_argument("-p", "--package", default="com.piuu.launcher.repository", help="Kotlin package name")

    # Extension
    ext_p = subparsers.add_parser("extension", help="Scaffold a .piuu extension project template")
    ext_p.add_argument("dir", help="Destination directory path")
    ext_p.add_argument("--name", default="My Extension", help="Extension name")
    ext_p.add_argument("--version", default="1.0.0", help="Extension version")

    if len(sys.argv) < 2:
        parser.print_help()
        sys.exit(0)

    args = parser.parse_args()

    if args.command == "compose":
        out = scaffold_compose_component(args.file, package_name=args.package)
        print(f"✨ Scaffolded Compose Component at: {out}")

    elif args.command == "repo":
        out = scaffold_repository(args.file, package_name=args.package)
        print(f"✨ Scaffolded Kotlin Repository at: {out}")

    elif args.command == "extension":
        out = scaffold_extension_template(args.dir, name=args.name, version=args.version)
        print(f"✨ Scaffolded Extension Template at: {out}")

if __name__ == "__main__":
    main()
