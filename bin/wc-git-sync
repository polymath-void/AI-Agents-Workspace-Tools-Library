#!/data/data/com.termux/files/usr/bin/env python3
import sys
import os

# Add the lib directory to sys.path
sys.path.append(os.path.join(os.path.dirname(__file__), '../lib'))
from git_helper import get_git_status, sync_branches

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print("Usage: wc-git-sync <command> [arguments...]")
        print("  Commands:")
        print("    status [dir]                : Shows branch status, staged, modified & last commit")
        print("    sync [dir] [src] [target]   : Fast-forwards target branch to match src (default: main -> master)")
        print("  Examples:")
        print("    wc-git-sync status")
        print("    wc-git-sync sync . main master")
        sys.exit(0)

    cmd = sys.argv[1]
    repo_path = sys.argv[2] if len(sys.argv) > 2 and not sys.argv[2].startswith("-") else "."

    if cmd == "status":
        info = get_git_status(repo_path)
        if not info["is_git"]:
            print(f"Error: '{repo_path}' is not a git repository.", file=sys.stderr)
            sys.exit(1)

        status_str = "✨ Clean" if info["clean"] else "⚠️  Modified"
        print(f"\n🌱 --- Git Repository Status for '{repo_path}' ---")
        print(f"  Branch       : {info['current_branch']}")
        print(f"  Working Tree : {status_str}")
        print(f"  Last Commit  : {info['last_commit']}")
        if info["staged"]:
            print(f"  Staged ({len(info['staged'])}): {', '.join(info['staged'][:5])}")
        if info["modified"]:
            print(f"  Modified ({len(info['modified'])}): {', '.join(info['modified'][:5])}")
        if info["untracked"]:
            print(f"  Untracked ({len(info['untracked'])}): {', '.join(info['untracked'][:5])}")
        print("-------------------------------------------------")

    elif cmd == "sync":
        src = sys.argv[3] if len(sys.argv) > 3 else "main"
        target = sys.argv[4] if len(sys.argv) > 4 else "master"
        print(f"Syncing branch '{target}' with '{src}' in '{repo_path}'...")
        success, message = sync_branches(repo_path, source_branch=src, target_branch=target)
        if success:
            print(f"✅ {message}")
        else:
            print(f"❌ {message}", file=sys.stderr)
            sys.exit(1)
    else:
        print(f"Unknown command: '{cmd}'. Use 'status' or 'sync'.", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
